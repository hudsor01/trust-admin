# Trust Administration System - Environment Variables Example
# Copy this to .env and fill in your values

# =============================================================================
# DOCKER POSTGRES CONFIGURATION
# =============================================================================
POSTGRES_USER=trust_admin
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=trust_admin
POSTGRES_PORT=5432

# =============================================================================
# DATABASE URL
# =============================================================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://trust_admin:your_strong_password_here@localhost:5432/trust_admin"

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Cron schedule (default: daily at 2 AM)
BACKUP_SCHEDULE="0 2 * * *"
# Retention policy
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# =============================================================================
# TIMEZONE
# =============================================================================
TZ=America/Chicago

# =============================================================================
# EMAIL (RESEND)
# =============================================================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Optional: Custom sender email (requires verified domain in Resend)
# Default uses Resend's test domain: "Trust Admin <onboarding@resend.dev>"
# EMAIL_FROM="Trust Admin <noreply@yourdomain.com>"
