# ============================================================================
# Trust Admin — Environment Variables
# ============================================================================
# Copy to .env and fill in real values.
# Bun auto-loads .env — no dotenv package needed.

# ============================================================================
# DATABASE (Required)
# ============================================================================
# Use the pooler endpoint (-pooler suffix) for production.
# Get from: Neon Console → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ============================================================================
# NEON AUTH (Required)
# ============================================================================
# Enable in: Neon Console → Auth tab
# Format: https://<endpoint-id>.neonauth.<region>.aws.neon.tech/<dbname>/auth
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth

# ============================================================================
# TRUST OWNER (Required)
# ============================================================================
# This email always gets admin access, regardless of database role.
ADMIN_EMAIL=owner@example.com

# ============================================================================
# OPTIONAL FEATURES
# ============================================================================

# Inventory image analysis via Claude
# Get key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Passphrase for the public inventory submission form
INVENTORY_ACCESS_CODE=hudson-living-trust

# File uploads for inventory photos (UploadThing)
# Get token from: https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=your-uploadthing-token

# ============================================================================
# ERROR MONITORING — SENTRY (Optional)
# ============================================================================
# Get DSN from: https://sentry.io/settings/[org]/projects/[project]/keys/
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
# Generate at: https://sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=your-auth-token
