# ============================================================================
# Trust Admin - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# Bun automatically loads .env files - no dotenv package needed

# ============================================================================
# DATABASE (Required)
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/trust_admin

# ============================================================================
# SERVER
# ============================================================================
PORT=5050
NODE_ENV=development

# ============================================================================
# AUTHENTICATION (Required for production)
# ============================================================================
# Generate a random secret:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=your-random-32+-character-secret-here

# ============================================================================
# EMAIL (Optional - server runs without it, but magic links won't work)
# ============================================================================
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Trust Admin <admin@thehudsonfam.com>

# ============================================================================
# URLS (Required for production, defaults to localhost in development)
# ============================================================================
# Production example: trust.thehudsonfam.com
FRONTEND_URL=https://trust.thehudsonfam.com
API_URL=https://trust.thehudsonfam.com

# ============================================================================
# CORS & TRUSTED ORIGINS (Comma-separated lists)
# ============================================================================
# Trusted origins for Better Auth (where login requests come from)
# Production: Use your actual domain
TRUSTED_ORIGINS=https://trust.thehudsonfam.com

# Allowed origins for CORS (frontend domains that can make API requests)
# Production: Use your actual domain
ALLOWED_ORIGINS=https://trust.thehudsonfam.com

# ============================================================================
# MONITORING (Optional but recommended for production)
# ============================================================================
# Get DSN from: https://sentry.io/settings/projects/
# Backend error reporting (API server)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Frontend error reporting (React app - must be prefixed with VITE_)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================================================
# DEVELOPMENT DEFAULTS
# ============================================================================
# For local development, you can use these minimal settings:
#
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trust_admin
# PORT=5050
# NODE_ENV=development
# BETTER_AUTH_SECRET=development-secret-minimum-32-characters-long-for-testing
#
# The server will run without email (RESEND_API_KEY) in development mode.
# CORS and trusted origins default to localhost:5173 and localhost:5050.
