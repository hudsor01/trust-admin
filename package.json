{
  "name": "trust-admin",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,magenta \"bun run dev:api\" \"bun run dev:ui\"",
    "dev:api": "NODE_ENV=development PORT=5050 bun --hot index.ts",
    "dev:ui": "bunx vite",
    "dev:start": "node scripts/start-dev.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun db/seed-hudson-trust.ts",
    "db:seed:dev": "bun db/seed-dev.ts",
    "db:seed:reset": "bun -e \"import { reset } from 'drizzle-seed'; import { db } from './db'; import * as schema from './db/schema'; reset(db, schema).then(() => console.log('Reset complete'))\"",
    "studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/bun": "latest",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "autoprefixer": "10.4.23",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.8",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.18",
    "vite": "7.3.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
