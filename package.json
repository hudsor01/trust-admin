{
  "name": "trust-admin",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/api tests/components tests/lib tests/trpc tests/*.test.ts",
    "test:unit": "bun test --bail tests/api tests/components tests/lib tests/trpc tests/*.test.ts",
    "test:watch": "bun test --watch tests/api tests/components tests/lib tests/trpc tests/*.test.ts",
    "test:coverage": "bun test --coverage tests/api tests/components tests/lib tests/trpc tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:deploy": "drizzle-kit generate --config drizzle.config.ts && drizzle-kit migrate --config drizzle.config.ts",
    "db:push": "echo 'WARNING: db:push has RLS policy bugs. Use db:deploy instead.' && drizzle-kit push --config drizzle.config.ts",
    "db:pull": "drizzle-kit pull --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:seed": "bun db/seed-hudson-trust.ts",
    "db:seed:dev": "bun db/seed-dev.ts",
    "db:seed:reset": "bun -e \"import { reset } from 'drizzle-seed'; import { db } from './db'; import * as schema from './db/schema'; reset(db, schema).then(() => console.log('Reset complete'))\"",
    "studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@happy-dom/global-registrator": "20.7.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.0",
    "@tanstack/react-query-devtools": "5.91.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.3.9",
    "@types/node": "25.3.0",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.9",
    "happy-dom": "20.7.0",
    "lefthook": "2.1.1",
    "postcss": "8.5.6",
    "tailwindcss": "4.2.0"
  },
