{
  "name": "trust-admin",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=DEP0205' next dev",
    "build": "NODE_OPTIONS='--disable-warning=DEP0205' next build",
    "build:analyze": "NODE_OPTIONS='--disable-warning=DEP0205' ANALYZE=true next build --webpack",
    "start": "NODE_OPTIONS='--disable-warning=DEP0205' next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000 tests/api tests/components tests/lib tests/trpc tests/*.test.ts",
    "test:unit": "bun test --bail --timeout 30000 tests/api tests/components tests/lib tests/trpc tests/*.test.ts",
    "test:watch": "bun test --watch --timeout 30000 tests/api tests/components tests/lib tests/trpc tests/*.test.ts",
    "test:coverage": "bun test --coverage --timeout 30000 tests/api tests/components tests/lib tests/trpc tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:deploy": "drizzle-kit generate --config drizzle.config.ts && drizzle-kit migrate --config drizzle.config.ts",
    "db:push": "echo 'WARNING: db:push has RLS policy bugs. Use db:deploy instead.' && drizzle-kit push --config drizzle.config.ts",
    "db:pull": "drizzle-kit pull --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:seed": "bun db/seed-hudson-trust.ts",
    "db:seed:dev": "bun db/seed-dev.ts",
    "db:seed:reset": "bun -e \"import { reset } from 'drizzle-seed'; import { db } from './db'; import * as schema from './db/schema'; reset(db, schema).then(() => console.log('Reset complete'))\"",
    "studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@happy-dom/global-registrator": "20.10.1",
    "@next/bundle-analyzer": "16.2.7",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.3.14",
    "@types/lodash.throttle": "4.1.9",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.10",
    "drizzle-seed": "0.3.1",
    "happy-dom": "20.10.1",
    "lefthook": "2.1.9",
    "postcss": "8.5.15",
    "tailwindcss": "4.3.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
