node_modules
.next
.git
.github

# env files — .env would otherwise be copied into the builder via
# `COPY . .` and leak into image history
.env*

# markdown — exclude repo docs but keep runtime-served files under public/
*.md
!public/**/*.md

# editor / tooling
.vscode
.idea

# test + planning artifacts (not needed at build time)
tests
playwright-report
playwright.config.ts
test-results
coverage
.planning

# local dev bleed (runtime uploads land here during local testing; prod
# writes go to UploadThing, so this dir should never enter an image)
public/uploads

# docker itself (prevents context churn when Dockerfile changes)
Dockerfile
.dockerignore
