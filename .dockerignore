node_modules
.next
.git
.github

# env files — block everything except the example; .env would otherwise
# be copied into the builder via `COPY . .` and leak into image history
.env*
!.env.example

# markdown — exclude repo docs but keep runtime-served files under public/
*.md
!public/**/*.md

# editor / tooling
.vscode
.idea

# test + planning artifacts (not needed at build time)
tests
playwright-report
playwright.config.ts
test-results
coverage
.planning

# docker itself (prevents context churn when Dockerfile changes)
Dockerfile
.dockerignore
